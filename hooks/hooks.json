{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/cache-expiry-check.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/statusline-version-check.sh 2>/dev/null || true",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "sed \"s|__PLUGIN_ROOT__|${CLAUDE_PLUGIN_ROOT}|g\" ${CLAUDE_PLUGIN_ROOT}/hooks/session-architecture.md 2>/dev/null || true",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/git-context-lite.sh 2>/dev/null || true",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/s-continue-after-compact.sh 2>/dev/null || true",
            "timeout": 35
          }
        ]
      }
    ]
  }
}
