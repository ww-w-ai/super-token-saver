{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sed \"s|__PLUGIN_ROOT__|${CLAUDE_PLUGIN_ROOT}|g\" \"${CLAUDE_PLUGIN_ROOT}/hooks/session-architecture-codex.md\" 2>/dev/null || true",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/s-continue-after-compact.sh\" 2>/dev/null || true",
            "timeout": 35,
            "additionalContextLimit": 0
          }
        ]
      }
    ]
  }
}
